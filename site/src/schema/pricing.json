{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{PAGE_URL}}#webpage",
      "url": "{{PAGE_URL}}",
      "name": "{{PAGE_TITLE}}",
      "about": { "@id": "{{SITE_URL}}/#organization" }
    },
    {
      "@type": "Service",
      "name": "Junk removal",
      "provider": { "@id": "{{SITE_URL}}/#organization" },
      "offers": {{PRICE_OFFERS}}
    }
  ]
}
